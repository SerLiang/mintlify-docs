  "keyFeatures": [
    "Paginated trader activity — every buy, sell, and redeem across all Polymarket markets",
    "Deposits & withdrawals history — full USDC transfer record for any wallet",
    "Transaction decoder — human-readable summary and individual fills for any on-chain tx hash",
    "Cursor-based pagination with configurable page sizes up to 100 records",
    "Filter activity by market ID, transaction hash, block range, or timestamp range",
    "Standard JSON response envelope with consistent error codes",
    "Bearer token authentication with per-plan rate limits"
  ],
  "publicApiSurface": [
    "GET /v1/trader/{address}/activity",
    "GET /v1/trader/{address}/deposits-withdrawals",
    "GET /v1/tx/{txHash}"
  ]
